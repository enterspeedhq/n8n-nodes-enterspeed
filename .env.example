# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.

# Required: used to encrypt saved credentials. Set to any random string.
N8N_ENCRYPTION_KEY=change-me

# Enterspeed demo tenant API keys (ask the team for these).
ENTERSPEED_SOURCE_API_KEY=
ENTERSPEED_ENVIRONMENT_API_KEY=

# Contentful demo tenant API keys
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# Enterspeed Context Graph (optional). Leave blank to use the local dev-server
# (@enterspeed/dev-server on port 5200), which accepts any API key.
CONTEXT_GRAPH_API_KEY=
CONTEXT_GRAPH_INGEST_URL=
CONTEXT_GRAPH_DELIVERY_URL=
CONTEXT_GRAPH_MANIFEST_VERSION=