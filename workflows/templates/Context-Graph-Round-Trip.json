{
  "name": "Context Graph · Round trip (upload an export, read it back)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 2
            }
          ]
        }
      },
      "name": "Every night",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:5500/exports/latest/exports.json",
        "options": {}
      },
      "name": "Fetch the export facts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        220,
        100
      ]
    },
    {
      "parameters": {
        "url": "=http://host.docker.internal:5500/exports/latest/{{ $json.file }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "name": "Fetch the export file",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        440,
        100
      ]
    },
    {
      "parameters": {
        "resource": "artifact",
        "operation": "upload",
        "sourceAlias": "catalogue",
        "binaryPropertyName": "data",
        "contentType": "ndjson",
        "asOf": "={{ $('Fetch the export facts').item.json.asOf }}",
        "rowCount": "={{ $('Fetch the export facts').item.json.rowCount }}"
      },
      "name": "Upload the export",
      "type": "CUSTOM.enterspeedContextGraph",
      "typeVersion": 1,
      "position": [
        660,
        100
      ],
      "credentials": {
        "enterspeedContextGraphApi": {
          "id": "__ENTERSPEED_CONTEXT_GRAPH_CREDENTIAL_ID__",
          "name": "Enterspeed Context Graph account"
        }
      }
    },
    {
      "parameters": {
        "resource": "artifact",
        "operation": "get",
        "sourceAlias": "catalogue",
        "artifactId": "={{ $json.id }}"
      },
      "name": "Read the upload's status",
      "type": "CUSTOM.enterspeedContextGraph",
      "typeVersion": 1,
      "position": [
        880,
        100
      ],
      "credentials": {
        "enterspeedContextGraphApi": {
          "id": "__ENTERSPEED_CONTEXT_GRAPH_CREDENTIAL_ID__",
          "name": "Enterspeed Context Graph account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "3f1c2a52-7d0b-4e59-9a31-6a2f0d6c8b11",
              "leftValue": "={{ $json.state }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "drained"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Drained?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1100,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "8c4e1d27-5b6a-4f03-8e92-1d7a3b5c9f20",
              "leftValue": "={{ ['committed', 'draining'].includes($json.state) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Still draining?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1100,
        340
      ]
    },
    {
      "parameters": {
        "amount": 60
      },
      "name": "Wait a minute",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1320,
        260
      ],
      "webhookId": "6b0e2f7a-41c9-4d8e-b3a5-9e17c2d84f06"
    },
    {
      "parameters": {
        "errorMessage": "=The upload didn't drain: it is {{ $json.state }}{{ $json.failureReason ? ' (' + $json.failureReason + ')' : '' }}."
      },
      "name": "Stop: the upload didn't drain",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1320,
        460
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "a2d9e4b3-6c18-4f7e-9b05-4e3c8a1f7d62",
              "leftValue": "={{ $json.drain.result.refused + $json.drain.result.failed + $json.drain.result.unparseable }}",
              "operator": {
                "type": "number",
                "operation": "equals"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Every line landed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1320,
        100
      ]
    },
    {
      "parameters": {
        "resource": "index",
        "operation": "query",
        "queryFrom": "json",
        "query": "{ \"id\": \"products\", \"index\": \"ProductIndex\", \"limit\": 100 }"
      },
      "name": "Read it back",
      "type": "CUSTOM.enterspeedContextGraph",
      "typeVersion": 1,
      "position": [
        1540,
        0
      ],
      "credentials": {
        "enterspeedContextGraphApi": {
          "id": "__ENTERSPEED_CONTEXT_GRAPH_CREDENTIAL_ID__",
          "name": "Enterspeed Context Graph account"
        }
      }
    },
    {
      "parameters": {
        "resource": "artifact",
        "operation": "getLines",
        "sourceAlias": "catalogue",
        "artifactId": "={{ $json.id }}",
        "limit": 10
      },
      "name": "The lines that didn't land",
      "type": "CUSTOM.enterspeedContextGraph",
      "typeVersion": 1,
      "position": [
        1540,
        200
      ],
      "credentials": {
        "enterspeedContextGraphApi": {
          "id": "__ENTERSPEED_CONTEXT_GRAPH_CREDENTIAL_ID__",
          "name": "Enterspeed Context Graph account"
        }
      }
    },
    {
      "parameters": {
        "errorMessage": "=Line {{ $json.number }} of the export didn't land ({{ $json.outcome }}): {{ $json.reason }}"
      },
      "name": "Stop: a line didn't land",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1760,
        200
      ]
    },
    {
      "parameters": {
        "content": "## Upload an export, read it back\nThe whole loop with a source that hands over a **complete export file**: every night the workflow fetches the export, uploads it **as it is** and reads the result back out. No parsing, no mapping, no diffing: the graph works out what changed.\n\n- **Fetch** is the only step that knows the source system. Here it is a plain web server with the export and its facts (`exports.json`: `file`, `asOf`, `rowCount`); swap these two nodes for your own fetch.\n- **Upload** sends the file to the `catalogue` source with the source's own *As Of* and *Row Count*.\n- **Read the upload's status** waits for the drain: the local dev-server drains at once, a deployed graph later, so the workflow checks back every minute.\n- **Read it back** queries `ProductIndex` and outputs what the graph now holds.\n\nA line the graph refused or couldn't parse stops the run with the graph's own reason. The rest of the file still landed, but no line is lost silently.",
        "height": 520,
        "width": 640
      },
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        -560
      ]
    },
    {
      "parameters": {
        "content": "## Before you run it\n- **A dev-server with the `catalogue` schema**: `npm install` then `npm run serve` in this repo's `e2e` folder (Node 26) starts it, empty: the graph on :5200, this export on :5500. CI runs this workflow against it on every pull request.\n- **The credential** *Enterspeed Context Graph account* points at the dev-server, which accepts any key.\n- **Against a deployed Context Graph:** point the credential at its Ingest and Delivery URLs, each with its own key, and set *Manifest Version* to the manifest's ID (the hash `enterspeed-graph publish` prints). The source must be a snapshot source, n8n must be able to reach the storage host the upload URL names, and if Ingest admits only listed addresses, n8n's must be on the list. Then change the source alias, the index query and the two fetch nodes.",
        "height": 220,
        "width": 640,
        "color": 7
      },
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -20,
        320
      ]
    }
  ],
  "connections": {
    "Every night": {
      "main": [
        [
          {
            "node": "Fetch the export facts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch the export facts": {
      "main": [
        [
          {
            "node": "Fetch the export file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch the export file": {
      "main": [
        [
          {
            "node": "Upload the export",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload the export": {
      "main": [
        [
          {
            "node": "Read the upload's status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the upload's status": {
      "main": [
        [
          {
            "node": "Drained?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Drained?": {
      "main": [
        [
          {
            "node": "Every line landed?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Still draining?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still draining?": {
      "main": [
        [
          {
            "node": "Wait a minute",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Stop: the upload didn't drain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait a minute": {
      "main": [
        [
          {
            "node": "Read the upload's status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every line landed?": {
      "main": [
        [
          {
            "node": "Read it back",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "The lines that didn't land",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "The lines that didn't land": {
      "main": [
        [
          {
            "node": "Stop: a line didn't land",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
