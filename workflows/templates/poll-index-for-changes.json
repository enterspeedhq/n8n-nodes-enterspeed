        848,
        304
      ],
      "credentials": {
        "enterspeedApi": {
          "id": "__ENTERSPEED_CREDENTIAL_ID__",
          "name": "N8N contentful tenant"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const config = $('Poll Config').first().json;\nconst { markerField, idField, emitOnFirst } = config;\n\nconst response = $input.first().json;\nconst results = response.results ?? response.items ?? [];\n\nconst staticData = $getWorkflowStaticData('node');\nconst seen = staticData.seen ?? {};\nconst isFirstRun = Object.keys(seen).length === 0 && staticData.initialised !== true;\n\nconst marker = (item) => {\n  if (markerField && item[markerField] !== undefined) return String(item[markerField]);\n  return JSON.stringify(item);\n};\n\nconst changed = [];\nconst nextSeen = {};\n\nfor (const item of results) {\n  const id = String(item[idField] ?? item.id ?? '');\n  if (!id) continue;\n  const m = marker(item);\n  nextSeen[id] = m;\n  if (seen[id] === undefined || seen[id] !== m) {\n    changed.push({ json: item });\n  }\n}\n\nstaticData.seen = nextSeen;\nstaticData.initialised = true;\n\nif (isFirstRun && !emitOnFirst) return [];\nreturn changed;"
      },
