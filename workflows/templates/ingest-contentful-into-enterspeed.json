      "parameters": {
        "jsCode": "const entry = $input.first().json; // one raw entry for one locale: { metadata, sys, fields }\n\nfunction toId(contentfulId, localeCode) {\n  return `${contentfulId}-${localeCode}`.toLowerCase();\n}\n\nfunction formatDate(dateString) {\n  return dateString ? dateString.slice(0, 19) : null;\n}\n\nfunction isLink(value) {\n  return value && typeof value === 'object' && value.sys && value.sys.type === 'Link';\n}\n\nfunction convertLink(link, localeCode) {\n  return {\n    id: toId(link.sys.id, localeCode),\n    type: link.sys.type,\n    linkType: link.sys.linkType\n  };\n}\n\nfunction convertFieldValue(value, localeCode) {\n  if (value === null || value === undefined) return null;\n\n  if (Array.isArray(value)) {\n    if (value.length > 0 && isLink(value[0])) {\n      return value.map(v => convertLink(v, localeCode));\n    }\n    return value;\n  }\n\n  if (isLink(value)) {\n    return convertLink(value, localeCode);\n  }\n\n  return value;\n}\n\nfunction buildMetaData(sys) {\n  return {\n    locale: sys.locale,\n    type: sys.type,\n    environment: sys.environment?.sys?.id,\n    createDate: formatDate(sys.createdAt),\n    updateDate: formatDate(sys.updatedAt)\n  };\n}\n\nfunction buildEnterspeedEntity(entry) {\n  const sys = entry.sys;\n  const localeCode = sys.locale;\n  const properties = {};\n\n  for (const [fieldName, value] of Object.entries(entry.fields)) {\n    const converted = convertFieldValue(value, localeCode);\n    if (converted !== null) {\n      properties[fieldName] = converted;\n    }\n  }\n\n  properties.metaData = buildMetaData(sys);\n\n  return {\n    originId: toId(sys.id, localeCode),   // used only to build the URL path — not part of the body\n    type: sys.contentType.sys.id,\n    url: null,\n    originParentId: null,\n    redirects: [],\n    properties\n  };\n}\n\nreturn { json: buildEnterspeedEntity(entry) };"
      },
